set -u

PROJECT_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
APP_MODULE="src.main.sbk_charts"
MINIMUM_PYTHON="3.10"
CONDA_ENV_NAME="${SBK_CHARTS_CONDA_ENV:-sbk-charts}"
DEFAULT_VENV="$PROJECT_ROOT/venv-sbk-charts"

log() {
    printf '%s\n' "sbk-charts: $*" >&2
}

fail() {
    log "ERROR: $*"
    exit 1
}

python_is_supported() {
    "$1" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' \
        >/dev/null 2>&1
}

environment_is_ready() {
    "$1" -c 'from importlib.metadata import version; version("sbk-charts"); import src.main.sbk_charts' \
        >/dev/null 2>&1 && "$1" -m pip check >/dev/null 2>&1
}

install_project() {
    local python_path="$1"
    local environment_label="$2"

    if environment_is_ready "$python_path"; then
        log "Reusing $environment_label"
        return 0
    fi

    log "Installing sbk-charts into $environment_label"
    "$python_path" -m pip install --editable "$PROJECT_ROOT" || return 1
    environment_is_ready "$python_path"
}

run_application() {
    local python_path="$1"
    shift
    exec "$python_path" -m "$APP_MODULE" "$@"
}

try_virtual_environment() {
    local environment_dir="$1"
    local python_path
    shift
    [ -n "$environment_dir" ] || return 1
    python_path="$environment_dir/bin/python"
    [ -x "$python_path" ] || return 1
    python_is_supported "$python_path" || return 1
    install_project "$python_path" "virtual environment $environment_dir" || return 1
    run_application "$python_path" "$@"
}

try_conda_prefix() {
    local environment_dir="$1"
    local python_path
    shift
    [ -n "$environment_dir" ] || return 1
    python_path="$environment_dir/bin/python"
    [ -x "$python_path" ] || return 1
    python_is_supported "$python_path" || return 1
    install_project "$python_path" "Conda environment $environment_dir" || return 1
    run_application "$python_path" "$@"
}

if [ -n "${SBK_CHARTS_VENV:-}" ]; then
    try_virtual_environment "$SBK_CHARTS_VENV" "$@"
else
    try_virtual_environment "${VIRTUAL_ENV:-}" "$@"
    try_conda_prefix "${CONDA_PREFIX:-}" "$@"

    for environment_dir in \
        "$DEFAULT_VENV" \
        "$PROJECT_ROOT/.venv" \
        "$PROJECT_ROOT/sbk-charts-venv"
    do
        try_virtual_environment "$environment_dir" "$@"
    done
fi

conda_command=""
named_conda_environment_exists=0
if command -v conda >/dev/null 2>&1; then
    conda_command="$(command -v conda)"
    conda_prefix="$("$conda_command" run --name "$CONDA_ENV_NAME" python -c 'import sys; print(sys.prefix)' 2>/dev/null || true)"
    if [ -n "$conda_prefix" ]; then
        named_conda_environment_exists=1
        try_conda_prefix "$conda_prefix" "$@"
    fi
fi

system_python=""
for python_command in python3.14 python3.13 python3.12 python3.11 python3.10 python3 python
do
    if command -v "$python_command" >/dev/null 2>&1; then
        candidate="$(command -v "$python_command")"
        if python_is_supported "$candidate"; then
            system_python="$candidate"
            break
        fi
    fi
done

venv_dir="${SBK_CHARTS_VENV:-$DEFAULT_VENV}"
if [ -n "$system_python" ]; then
    log "Creating virtual environment $venv_dir with $system_python"
    if "$system_python" -m venv "$venv_dir"; then
        venv_python="$venv_dir/bin/python"
        if install_project "$venv_python" "virtual environment $venv_dir"; then
            run_application "$venv_python" "$@"
        fi
        log "Virtual environment setup failed; trying Conda"
    else
        log "Python venv creation failed; trying Conda"
    fi
fi

if [ -n "$conda_command" ]; then
    if [ "$named_conda_environment_exists" -eq 1 ]; then
        log "Updating Conda environment $CONDA_ENV_NAME with Python >= $MINIMUM_PYTHON"
        "$conda_command" install --yes --name "$CONDA_ENV_NAME" "python>=$MINIMUM_PYTHON" pip \
            || fail "Conda could not update environment $CONDA_ENV_NAME"
    else
        log "Creating Conda environment $CONDA_ENV_NAME with Python >= $MINIMUM_PYTHON"
        "$conda_command" create --yes --name "$CONDA_ENV_NAME" "python>=$MINIMUM_PYTHON" pip \
            || fail "Conda could not create environment $CONDA_ENV_NAME"
    fi
    conda_prefix="$("$conda_command" run --name "$CONDA_ENV_NAME" python -c 'import sys; print(sys.prefix)')"
    try_conda_prefix "$conda_prefix" "$@"
fi

if [ -z "$system_python" ]; then
    fail "Python >= $MINIMUM_PYTHON and Conda were not found. Install either one and retry."
fi

fail "Python >= $MINIMUM_PYTHON was found, but neither venv nor Conda could create a working environment. Ensure the Python venv module and network access to the package index are available."
